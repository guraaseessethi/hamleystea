# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SANITY_PROJECT_ID=a5yzz6tx
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only: Editor token from sanity.io/manage > API > Tokens. Used to save pickup orders.
SANITY_API_WRITE_TOKEN=
# Server only: shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=
# Where the hosted Studio lives (used for the "open order" link in the shop email)
NEXT_PUBLIC_STUDIO_URL=

# Resend (free tier)
RESEND_API_KEY=
EMAIL_FROM="Hamley's Tea & Coffee <orders@example.com>"
SHOP_NOTIFICATION_EMAIL=

# Payments later. Leave false until HelcimPay.js is built.
PAYMENTS_HELCIM_ENABLED=false
